generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  name              String?
  googleUserId      String   @unique
  googleRefreshToken String
  defaultSheetId    String?
  defaultAlbumId    String?
  trips             Trip[]
  localities        Locality[]
  specimens         Specimen[]
  photos            Photo[]
  tags              Tag[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Trip {
  id        String     @id @default(cuid())
  user      User       @relation(fields: [userId], references: [id])
  userId    String
  name      String
  date      DateTime
  notes     String?
  tripLocalities TripLocality[]
  specimens  Specimen[]
  photos     Photo[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Locality {
  id           String     @id @default(cuid())
  user         User       @relation(fields: [userId], references: [id])
  userId       String
  name         String
  latitude     Float
  longitude    Float
  nearestTown  String?
  stateProvince String?
  country      String?
  accessNotes  String?
  formation    String?
  stratUnit    String?
  age          String?
  tripLinks    TripLocality[]
  specimens    Specimen[]
  photos       Photo[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TripLocality {
  id         String   @id @default(cuid())
  trip       Trip     @relation(fields: [tripId], references: [id])
  tripId     String
  locality   Locality @relation(fields: [localityId], references: [id])
  localityId String
  createdAt  DateTime @default(now())

  @@unique([tripId, localityId])
}

model Specimen {
  id              String   @id
  user            User     @relation(fields: [userId], references: [id])
  userId          String
  trip            Trip     @relation(fields: [tripId], references: [id])
  tripId          String
  locality        Locality @relation(fields: [localityId], references: [id])
  localityId      String
  collectionDate  DateTime
  shortDescription String
  category        String
  storageLocation String?
  lithology       String?
  fossilGroup     String?
  prepStatus      String?
  keepTradeStatus String?
  notes           String?
  photos          Photo[]
  specimenTags    SpecimenTag[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Photo {
  id               String   @id @default(cuid())
  user             User     @relation(fields: [userId], references: [id])
  userId           String
  specimen         Specimen? @relation(fields: [specimenId], references: [id])
  specimenId       String?
  trip             Trip     @relation(fields: [tripId], references: [id])
  tripId           String
  locality         Locality @relation(fields: [localityId], references: [id])
  localityId       String
  googleMediaItemId String
  googlePhotosUrl   String
  takenAt          DateTime?
  gpsLat           Float?
  gpsLon           Float?
  caption          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Tag {
  id        String        @id @default(cuid())
  user      User          @relation(fields: [userId], references: [id])
  userId    String
  name      String
  specimens SpecimenTag[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
}

model SpecimenTag {
  specimen   Specimen @relation(fields: [specimenId], references: [id])
  specimenId String
  tag        Tag      @relation(fields: [tagId], references: [id])
  tagId      String

  @@id([specimenId, tagId])
}
